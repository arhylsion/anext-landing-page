---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import TrustedBy from '../components/TrustedBy.astro';
import WhatIsAnext from '../components/WhatIsAnext.astro';
import OurServices from '../components/OurServices.astro';
import Process from '../components/Process.astro';
import TechStack from '../components/TechStack.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout>
  <main id="main-content">
    <Hero />
    <div class="flex justify-center md:mt-20 mt-8 mb-0">
      <TrustedBy />
    </div>
    <WhatIsAnext />
    <OurServices />
    <Process />
    <TechStack />
    <About />
    <Testimonials />
    <FinalCTA />
  </main>
  <Footer />
</MainLayout>
